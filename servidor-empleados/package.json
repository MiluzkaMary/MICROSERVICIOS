{
  "name": "servidor-empleados",
  "version": "1.0.0",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.53.0",
    "@opentelemetry/exporter-zipkin": "^2.0.1",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "amqplib": "^0.10.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "opossum": "^8.1.4",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "jest": "^30.0.5",
    "nyc": "^17.1.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/unit/**/*.test.js"]
  },
  "nyc": {
    "include": ["src/**/*.js"],
    "exclude": ["src/config/**", "node_modules/**"],
    "reporter": ["lcov", "text"],
    "report-dir": "coverage"
  }
}
