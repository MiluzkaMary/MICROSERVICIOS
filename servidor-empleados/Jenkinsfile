pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'cd servidor-empleados && npm install'
            }
        }

        stage('Test') {
            steps {
                sh 'cd servidor-empleados && npm run test:coverage'
            }
        }

        stage('SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_AUTH_TOKEN')]) {
                        sh 'cd servidor-empleados && sonar-scanner -Dsonar.token=${SONAR_AUTH_TOKEN}'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package') {
            steps {
                sh '''
                    docker build \
                      -f servidor-empleados/Dockerfile \
                      -t servidor-empleados:${BUILD_NUMBER} \
                      -t servidor-empleados:latest \
                      servidor-empleados
                '''
            }
        }

        stage('E2E Tests') {
            steps {
                sh '''
                    set -e

                    cat > .ci.env <<'EOF'
JWT_SECRET=ci-jwt-secret-for-jenkins
JWT_EXPIRATION=24h
JWT_EXPIRES_IN=24h
DB_USER=postgres
DB_PASSWORD=postgres
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
AUTH_SERVICE_URL=http://auth-service:8084
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=Sistema RH <rh@empresa.com>
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=admin123
USER_EMAIL=juan.solis@gmail.com
USER_PASSWORD=Rabbit
EOF

                                        set -a
                                        . ./.ci.env
                                        set +a

                                        for i in $(seq 1 30); do
                                            auth_code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8084/health || true)
                                            emp_code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8080/health || true)
                                            dep_code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8081/health || true)
                                            per_code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8082/health || true)
                                            noti_code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8083/health || true)
                                            gw_code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8085/health || true)

                                            if [ "$auth_code" = "200" ] && [ "$emp_code" = "200" ] && [ "$dep_code" = "200" ] && [ "$per_code" = "200" ] && [ "$noti_code" = "200" ] && [ "$gw_code" = "200" ]; then
                                                echo "Stack base listo para E2E."
                                                break
                                            fi

                                            if [ "$i" -eq 30 ]; then
                                                echo "Timeout esperando que el stack base esté arriba. auth=$auth_code emp=$emp_code dep=$dep_code per=$per_code noti=$noti_code gw=$gw_code"
                                                exit 1
                                            fi

                                            echo "Esperando stack base... intento $i/30"
                                            sleep 5
                                        done

                    for i in $(seq 1 15); do
                      auth_code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8084/health || true)
                      emp_code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8080/health || true)

                      if [ "$auth_code" = "200" ] && [ "$emp_code" = "200" ]; then
                        echo "Servicios auth y empleados listos para E2E."
                        break
                      fi

                      if [ "$i" -eq 15 ]; then
                        echo "Timeout esperando health checks. auth=$auth_code empleados=$emp_code"
                        exit 1
                      fi

                      echo "Intento $i/15: esperando auth/empleados (auth=$auth_code empleados=$emp_code)"
                      sleep 5
                    done

                    cd e2e-tests
                    npm install
                    BASE_URL="${BASE_URL:-http://localhost:8085}" \
                    ADMIN_EMAIL="${ADMIN_EMAIL}" \
                    ADMIN_PASSWORD="${ADMIN_PASSWORD}" \
                    USER_EMAIL="${USER_EMAIL}" \
                    USER_PASSWORD="${USER_PASSWORD}" \
                    POLLING_MAX_ATTEMPTS="30" \
                    POLLING_INTERVAL_MS="3000" \
                    MAILHOG_URL="${MAILHOG_URL:-http://localhost:8025}" \
                    npm test
                '''
            }
            post {
                always {
                    sh 'rm -f .ci.env || true'
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finalizado - Build #${BUILD_NUMBER}"
        }
        success {
            echo 'Todas las etapas pasaron'
        }
        failure {
            echo 'Pipeline falló - revisa la etapa en rojo'
        }
    }
}
