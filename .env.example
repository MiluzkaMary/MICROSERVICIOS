
# ==========================================
# JWT - Autenticación
# ==========================================
# Secret para firmar y verificar tokens JWT
# DEBE ser el mismo en todos los microservicios
# Recomendación: mínimo 32 caracteres aleatorios
JWT_SECRET=

# Tiempo de expiración del token JWT
JWT_EXPIRATION=24h
JWT_EXPIRES_IN=24h

# ==========================================
# Base de Datos PostgreSQL
# ==========================================
# Usuario de PostgreSQL (default: postgres)
DB_USER=postgres

# Contraseña de PostgreSQL
# CAMBIAR en producción
DB_PASSWORD=

# ==========================================
# RabbitMQ - Message Broker
# ==========================================
# Usuario de RabbitMQ
RABBITMQ_USER=guest

# Contraseña de RabbitMQ
# CAMBIAR en producción
RABBITMQ_PASSWORD=

# ==========================================
# URLs de Servicios
# ==========================================
# URL base del servicio de autenticación
# Usado en templates de email
AUTH_SERVICE_URL=http://localhost:8084

# ==========================================
# SMTP - Email (Mailhog para desarrollo)
# ==========================================
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=Sistema RH <rh@empresa.com>
