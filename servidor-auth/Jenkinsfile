pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    environment {
        NODE_VERSION = '18'
        NPM_CACHE = '/root/.npm'
    }

    stages {
        stage('Verificación de Herramientas') {
            steps {
                echo '✅ Verificando herramientas disponibles...'
                sh 'node --version'
                sh 'npm --version'
                sh 'docker --version'
            }
        }

        stage('Checkout') {
            steps {
                echo '📦 Clonando repositorio...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo '📚 Instalando dependencias...'
                dir('servidor-auth') {
                    sh 'npm install'
                }
            }
        }

        stage('Pruebas Unitarias') {
            steps {
                echo '🧪 Ejecutando pruebas unitarias...'
                dir('servidor-auth') {
                    sh 'npm run test || true'
                }
            }
        }

        stage('Análisis de Cobertura') {
            steps {
                echo '📊 Generando reporte de cobertura...'
                dir('servidor-auth') {
                    sh 'npm run test:coverage || true'
                }
                publishHTML([
                    reportDir: 'servidor-auth/coverage',
                    reportFiles: 'index.html',
                    reportName: 'Code Coverage Report - servidor-auth',
                    keepAll: true,
                    alwaysLinkToLastBuild: true
                ]) || true
            }
        }

        stage('Construcción Docker') {
            steps {
                echo '🐳 Construyendo imagen Docker de servidor-auth...'
                sh 'docker build -t reto1-auth-service:latest ./servidor-auth/'
                sh 'docker image ls | grep reto1-auth-service'
            }
        }

        stage('Análisis SonarQube (Opcional)') {
            when {
                expression { 
                    return fileExists('servidor-auth/sonar-project.properties')
                }
            }
            steps {
                echo '🔍 Ejecutando análisis SonarQube...'
                dir('servidor-auth') {
                    sh 'sonar-scanner || true'
                }
            }
        }
    }

    post {
        always {
            echo '📌 Fase de limpieza y reportes finales...'
            
            // Limpia artefactos anteriores
            cleanWs(deleteDirs: true)
        }

        success {
            echo '✅ Pipeline ejecutado exitosamente'
            echo '✅ Servicio auth listo para desplegar'
        }

        failure {
            echo '❌ Pipeline falló'
            echo '❌ Revisa los logs arriba para más detalles'
        }
    }
}
