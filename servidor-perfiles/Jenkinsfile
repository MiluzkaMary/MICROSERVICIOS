pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'cd servidor-perfiles && go build ./...'
            }
        }

        stage('Test') {
            steps {
                sh 'cd servidor-perfiles && go test ./... -coverprofile=coverage.out -v'
            }
        }

        stage('SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_AUTH_TOKEN')]) {
                        sh 'cd servidor-perfiles && sonar-scanner -Dsonar.token=${SONAR_AUTH_TOKEN}'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package') {
            steps {
                sh '''
                    docker build \
                      -f servidor-perfiles/Dockerfile \
                      -t servidor-perfiles:${BUILD_NUMBER} \
                      -t servidor-perfiles:latest \
                      servidor-perfiles
                '''
            }
        }
    }

    post {
        always {
            echo "Pipeline finalizado - Build #${BUILD_NUMBER}"
        }
        success {
            echo 'Todas las etapas pasaron'
        }
        failure {
            echo 'Pipeline falló - revisa la etapa en rojo'
        }
    }
}